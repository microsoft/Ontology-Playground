  <owl:ObjectProperty rdf:about="https://ontology-playground.example/organization-graph#implements"><rdfs:label>implements</rdfs:label></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://ontology-playground.example/organization-graph#beforeUnit"><rdfs:label>before unit</rdfs:label></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://ontology-playground.example/organization-graph#afterUnit"><rdfs:label>after unit</rdfs:label></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://ontology-playground.example/organization-graph#trackedBy"><rdfs:label>tracked by</rdfs:label></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://ontology-playground.example/organization-graph#companyA"><rdfs:label>company A</rdfs:label></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://ontology-playground.example/organization-graph#companyB"><rdfs:label>company B</rdfs:label></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://ontology-playground.example/organization-graph#inMarket"><rdfs:label>in market</rdfs:label></owl:ObjectProperty>
</rdf:RDF>
