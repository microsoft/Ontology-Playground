    <!-- ================== -->
    <!-- Object Properties -->
    <!-- ================== -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/unnamed/rel-relates-to-1">
        <rdfs:label>submits</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/unnamed/New-entity-1"/>
        <rdfs:range rdf:resource="http://example.org/ontology/unnamed/New-entity-3"/>
        <rdfs:comment>用户提交报修或求助请求</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>new-entity-1</ont:fromEntityId>
        <ont:toEntityId>new-entity-3</ont:toEntityId>
        <opl-meta:joinKey>id=customer_id</opl-meta:joinKey>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/unnamed/rel-relates-to-2">
        <rdfs:label>generates</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/unnamed/New-entity-3"/>
        <rdfs:range rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <rdfs:comment>客服受理服务请求并生成原工单</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>new-entity-3</ont:fromEntityId>
        <ont:toEntityId>new-entity-4</ont:toEntityId>
        <opl-meta:joinKey>id=request_id</opl-meta:joinKey>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/unnamed/rel-accepts">
        <rdfs:label>accepts</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/unnamed/New-entity-5"/>
        <rdfs:range rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <rdfs:comment>客服部门受理并持续跟踪工单</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>new-entity-5</ont:fromEntityId>
        <ont:toEntityId>new-entity-4</ont:toEntityId>
        <opl-meta:joinKey>id=cs_department_id</opl-meta:joinKey>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/unnamed/rel-located-at">
        <rdfs:label>located_at</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <rdfs:range rdf:resource="http://example.org/ontology/unnamed/New-entity-2"/>
        <rdfs:comment>工单关联上门服务地址</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>new-entity-4</ont:fromEntityId>
        <ont:toEntityId>new-entity-2</ont:toEntityId>
        <opl-meta:joinKey>address_id=id</opl-meta:joinKey>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/unnamed/rel-schedules">
        <rdfs:label>schedules</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <rdfs:range rdf:resource="http://example.org/ontology/unnamed/New-entity-8"/>
        <rdfs:comment>工单可包含多次上门预约</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>new-entity-4</ont:fromEntityId>
        <ont:toEntityId>new-entity-8</ont:toEntityId>
        <opl-meta:joinKey>id=work_order_id</opl-meta:joinKey>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/unnamed/rel-has-transfer">
        <rdfs:label>has_transfer</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <rdfs:range rdf:resource="http://example.org/ontology/unnamed/New-entity-9"/>
        <rdfs:comment>原工单保留全部转派记录</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>new-entity-4</ont:fromEntityId>
        <ont:toEntityId>new-entity-9</ont:toEntityId>
        <opl-meta:joinKey>id=work_order_id</opl-meta:joinKey>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/unnamed/rel-receives-transfer">
        <rdfs:label>receives_transfer</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/unnamed/New-entity-6"/>
        <rdfs:range rdf:resource="http://example.org/ontology/unnamed/New-entity-9"/>
        <rdfs:comment>对应服务部门接收转派</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>new-entity-6</ont:fromEntityId>
        <ont:toEntityId>new-entity-9</ont:toEntityId>
        <opl-meta:joinKey>id=service_department_id</opl-meta:joinKey>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/unnamed/rel-performs">
        <rdfs:label>performs</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/unnamed/New-entity-7"/>
        <rdfs:range rdf:resource="http://example.org/ontology/unnamed/New-entity-10"/>
        <rdfs:comment>服务人员执行现场处理</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>new-entity-7</ont:fromEntityId>
        <ont:toEntityId>new-entity-10</ont:toEntityId>
        <opl-meta:joinKey>id=technician_id</opl-meta:joinKey>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/unnamed/rel-reports-to">
        <rdfs:label>reports_to</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/unnamed/New-entity-10"/>
        <rdfs:range rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <rdfs:comment>现场处理结果反馈到原工单</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>new-entity-10</ont:fromEntityId>
        <ont:toEntityId>new-entity-4</ont:toEntityId>
        <opl-meta:joinKey>work_order_id=id</opl-meta:joinKey>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/unnamed/rel-gives-feedback">
        <rdfs:label>gives_feedback</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/unnamed/New-entity-1"/>
        <rdfs:range rdf:resource="http://example.org/ontology/unnamed/New-entity-11"/>
        <rdfs:comment>用户提交回访评价</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>new-entity-1</ont:fromEntityId>
        <ont:toEntityId>new-entity-11</ont:toEntityId>
        <opl-meta:joinKey>id=customer_id</opl-meta:joinKey>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/unnamed/rel-receives-feedback">
        <rdfs:label>receives_feedback</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <rdfs:range rdf:resource="http://example.org/ontology/unnamed/New-entity-11"/>
        <rdfs:comment>工单关联用户验收与回访评价</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>new-entity-4</ont:fromEntityId>
        <ont:toEntityId>new-entity-11</ont:toEntityId>
        <opl-meta:joinKey>id=work_order_id</opl-meta:joinKey>
    </owl:ObjectProperty>

    <!-- ============ -->
    <!-- Metrics (指标层) -->
    <!-- ============ -->

    <opl-metric:Metric rdf:about="http://example.org/ontology/unnamed/metric_pending_order_count">
        <opl-metric:name>pending_work_order_count</opl-metric:name>
        <opl-metric:displayName>待处理工单数</opl-metric:displayName>
        <opl-metric:kind>atomic</opl-metric:kind>
        <opl-metric:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <opl-metric:formula>COUNT(id)</opl-metric:formula>
        <opl-metric:requiredProperty>id</opl-metric:requiredProperty>
        <opl-metric:requiredProperty>status</opl-metric:requiredProperty>
        <opl-metric:requiredFilter>status NOT IN (&apos;已完成&apos;, &apos;已关闭&apos;)</opl-metric:requiredFilter>
        <opl-metric:supportedGranularity>day</opl-metric:supportedGranularity>
        <opl-metric:supportedGranularity>week</opl-metric:supportedGranularity>
        <opl-metric:supportedGranularity>month</opl-metric:supportedGranularity>
        <opl-metric:doNot>不含已完成和已关闭工单</opl-metric:doNot>
        <opl-metric:unit>单</opl-metric:unit>
    </opl-metric:Metric>

    <opl-metric:Metric rdf:about="http://example.org/ontology/unnamed/metric_transferred_order_count">
        <opl-metric:name>transferred_order_count</opl-metric:name>
        <opl-metric:displayName>转派工单数</opl-metric:displayName>
        <opl-metric:kind>atomic</opl-metric:kind>
        <opl-metric:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-9"/>
        <opl-metric:formula>COUNT(DISTINCT work_order_id)</opl-metric:formula>
        <opl-metric:requiredProperty>work_order_id</opl-metric:requiredProperty>
        <opl-metric:requiredProperty>status</opl-metric:requiredProperty>
        <opl-metric:requiredFilter>status != &apos;已退回&apos;</opl-metric:requiredFilter>
        <opl-metric:supportedGranularity>day</opl-metric:supportedGranularity>
        <opl-metric:supportedGranularity>week</opl-metric:supportedGranularity>
        <opl-metric:supportedGranularity>month</opl-metric:supportedGranularity>
        <opl-metric:doNot>按原工单去重；不含已退回的转派记录</opl-metric:doNot>
        <opl-metric:unit>单</opl-metric:unit>
    </opl-metric:Metric>

    <opl-metric:Metric rdf:about="http://example.org/ontology/unnamed/metric_overdue_order_count">
        <opl-metric:name>overdue_work_order_count</opl-metric:name>
        <opl-metric:displayName>超时工单数</opl-metric:displayName>
        <opl-metric:kind>atomic</opl-metric:kind>
        <opl-metric:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <opl-metric:formula>COUNT(id)</opl-metric:formula>
        <opl-metric:requiredProperty>id</opl-metric:requiredProperty>
        <opl-metric:requiredProperty>due_at</opl-metric:requiredProperty>
        <opl-metric:requiredProperty>status</opl-metric:requiredProperty>
        <opl-metric:requiredFilter>due_at &lt; NOW()</opl-metric:requiredFilter>
        <opl-metric:requiredFilter>status NOT IN (&apos;已完成&apos;, &apos;已关闭&apos;)</opl-metric:requiredFilter>
        <opl-metric:supportedGranularity>day</opl-metric:supportedGranularity>
        <opl-metric:supportedGranularity>week</opl-metric:supportedGranularity>
        <opl-metric:supportedGranularity>month</opl-metric:supportedGranularity>
        <opl-metric:doNot>不含已完成和已关闭工单</opl-metric:doNot>
        <opl-metric:unit>单</opl-metric:unit>
    </opl-metric:Metric>

    <opl-metric:Metric rdf:about="http://example.org/ontology/unnamed/metric_first_time_resolution">
        <opl-metric:name>first_time_resolution_rate</opl-metric:name>
        <opl-metric:displayName>一次解决率</opl-metric:displayName>
        <opl-metric:kind>atomic</opl-metric:kind>
        <opl-metric:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-10"/>
        <opl-metric:formula>SUM(resolved) / COUNT(id)</opl-metric:formula>
        <opl-metric:requiredProperty>id</opl-metric:requiredProperty>
        <opl-metric:requiredProperty>visit_sequence</opl-metric:requiredProperty>
        <opl-metric:requiredProperty>resolved</opl-metric:requiredProperty>
        <opl-metric:requiredFilter>visit_sequence = 1</opl-metric:requiredFilter>
        <opl-metric:supportedGranularity>day</opl-metric:supportedGranularity>
        <opl-metric:supportedGranularity>week</opl-metric:supportedGranularity>
        <opl-metric:supportedGranularity>month</opl-metric:supportedGranularity>
        <opl-metric:doNot>只统计首次上门；再次上门不进入分母</opl-metric:doNot>
        <opl-metric:unit>%</opl-metric:unit>
    </opl-metric:Metric>

    <opl-metric:Metric rdf:about="http://example.org/ontology/unnamed/metric_avg_visit_duration">
        <opl-metric:name>avg_visit_duration_minutes</opl-metric:name>
        <opl-metric:displayName>平均上门时长</opl-metric:displayName>
        <opl-metric:kind>atomic</opl-metric:kind>
        <opl-metric:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-10"/>
        <opl-metric:formula>AVG(duration_minutes)</opl-metric:formula>
        <opl-metric:requiredProperty>duration_minutes</opl-metric:requiredProperty>
        <opl-metric:requiredFilter>duration_minutes &gt;= 0</opl-metric:requiredFilter>
        <opl-metric:supportedGranularity>day</opl-metric:supportedGranularity>
        <opl-metric:supportedGranularity>week</opl-metric:supportedGranularity>
        <opl-metric:supportedGranularity>month</opl-metric:supportedGranularity>
        <opl-metric:doNot>不含预约等待和路途时长</opl-metric:doNot>
        <opl-metric:unit>分钟</opl-metric:unit>
    </opl-metric:Metric>

    <opl-metric:Metric rdf:about="http://example.org/ontology/unnamed/metric_customer_satisfaction">
        <opl-metric:name>customer_satisfaction</opl-metric:name>
        <opl-metric:displayName>用户满意度</opl-metric:displayName>
        <opl-metric:kind>atomic</opl-metric:kind>
        <opl-metric:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-11"/>
        <opl-metric:formula>AVG(score)</opl-metric:formula>
        <opl-metric:requiredProperty>score</opl-metric:requiredProperty>
        <opl-metric:requiredFilter>score BETWEEN 1 AND 5</opl-metric:requiredFilter>
        <opl-metric:supportedGranularity>day</opl-metric:supportedGranularity>
        <opl-metric:supportedGranularity>week</opl-metric:supportedGranularity>
        <opl-metric:supportedGranularity>month</opl-metric:supportedGranularity>
        <opl-metric:doNot>只统计有效回访评分，不代表未回访用户</opl-metric:doNot>
        <opl-metric:unit>分</opl-metric:unit>
    </opl-metric:Metric>

    <!-- =============== -->
    <!-- Event Types (事件层) -->
    <!-- =============== -->

