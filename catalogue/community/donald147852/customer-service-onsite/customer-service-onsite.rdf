    <owl:Class rdf:about="http://example.org/ontology/unnamed/New-entity-4">
        <rdfs:label>WorkOrder</rdfs:label>
        <ont:icon>📋</ont:icon>
        <ont:color>#5C2D91</ont:color>
        <opl-meta:displayName>工单</opl-meta:displayName>
        <opl-meta:objectType>fact</opl-meta:objectType>
        <opl-dyn:stateMachine>{&quot;property&quot;:&quot;status&quot;,&quot;initial&quot;:&quot;待受理&quot;,&quot;finals&quot;:[&quot;已关闭&quot;],&quot;transitions&quot;:[{&quot;id&quot;:&quot;t1&quot;,&quot;from&quot;:&quot;待受理&quot;,&quot;to&quot;:&quot;已受理&quot;,&quot;eventType&quot;:&quot;ev_work_order_accepted&quot;},{&quot;id&quot;:&quot;t2&quot;,&quot;from&quot;:&quot;已受理&quot;,&quot;to&quot;:&quot;待接收&quot;,&quot;eventType&quot;:&quot;ev_transfer_created&quot;},{&quot;id&quot;:&quot;t3&quot;,&quot;from&quot;:&quot;待接收&quot;,&quot;to&quot;:&quot;已转派&quot;,&quot;eventType&quot;:&quot;ev_transfer_accepted&quot;},{&quot;id&quot;:&quot;t4&quot;,&quot;from&quot;:&quot;待接收&quot;,&quot;to&quot;:&quot;处理中&quot;,&quot;eventType&quot;:&quot;ev_transfer_rejected&quot;},{&quot;id&quot;:&quot;t5&quot;,&quot;from&quot;:&quot;已转派&quot;,&quot;to&quot;:&quot;待接收&quot;,&quot;eventType&quot;:&quot;ev_transfer_rejected&quot;},{&quot;id&quot;:&quot;t6&quot;,&quot;from&quot;:&quot;已受理&quot;,&quot;to&quot;:&quot;待预约&quot;,&quot;eventType&quot;:&quot;ev_appointment_created&quot;},{&quot;id&quot;:&quot;t7&quot;,&quot;from&quot;:&quot;已转派&quot;,&quot;to&quot;:&quot;待预约&quot;,&quot;eventType&quot;:&quot;ev_appointment_created&quot;},{&quot;id&quot;:&quot;t8&quot;,&quot;from&quot;:&quot;待预约&quot;,&quot;to&quot;:&quot;待上门&quot;,&quot;eventType&quot;:&quot;ev_appointment_confirmed&quot;},{&quot;id&quot;:&quot;t9&quot;,&quot;from&quot;:&quot;待上门&quot;,&quot;to&quot;:&quot;待预约&quot;,&quot;eventType&quot;:&quot;ev_appointment_rescheduled&quot;},{&quot;id&quot;:&quot;t10&quot;,&quot;from&quot;:&quot;待上门&quot;,&quot;to&quot;:&quot;处理中&quot;,&quot;eventType&quot;:&quot;ev_visit_started&quot;},{&quot;id&quot;:&quot;t11&quot;,&quot;from&quot;:&quot;处理中&quot;,&quot;to&quot;:&quot;待验收&quot;,&quot;eventType&quot;:&quot;ev_result_reported&quot;},{&quot;id&quot;:&quot;t12&quot;,&quot;from&quot;:&quot;处理中&quot;,&quot;to&quot;:&quot;待预约&quot;,&quot;eventType&quot;:&quot;ev_visit_unresolved&quot;},{&quot;id&quot;:&quot;t13&quot;,&quot;from&quot;:&quot;待验收&quot;,&quot;to&quot;:&quot;已完成&quot;,&quot;eventType&quot;:&quot;ev_customer_accepted&quot;},{&quot;id&quot;:&quot;t14&quot;,&quot;from&quot;:&quot;待验收&quot;,&quot;to&quot;:&quot;待预约&quot;,&quot;eventType&quot;:&quot;ev_customer_rejected&quot;},{&quot;id&quot;:&quot;t15&quot;,&quot;from&quot;:&quot;已完成&quot;,&quot;to&quot;:&quot;已关闭&quot;,&quot;eventType&quot;:&quot;ev_feedback_received&quot;}]}</opl-dyn:stateMachine>
    </owl:Class>

