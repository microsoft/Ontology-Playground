    xmlns:opl-dyn="http://ontologyplayground.dev/dyn#"
>

    <owl:Ontology rdf:about="http://example.org/ontology/unnamed/">
        <rdfs:label>客服上门服务管理</rdfs:label>
        <rdfs:comment>面向客服部的上门服务闭环：用户报修或求助、客服受理建单、预约上门、跨部门转派、现场处理、结果反馈、用户验收与回访评价；转派后保留原工单并由客服持续跟踪。</rdfs:comment>
        <opl-meta:modelVersion>3</opl-meta:modelVersion>
    </owl:Ontology>

    <!-- ===================== -->
    <!-- Entity Types (Classes) -->
    <!-- ===================== -->

