    <!-- =============== -->
    <!-- Action Types (动作层) -->
    <!-- =============== -->

    <opl-dyn:ActionType rdf:about="http://example.org/ontology/unnamed/action_act_create_work_order">
        <opl-dyn:name>create_work_order</opl-dyn:name>
        <opl-dyn:displayName>受理建单</opl-dyn:displayName>
        <opl-dyn:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-3"/>
        <opl-dyn:parameters>[{&quot;name&quot;:&quot;priority&quot;,&quot;type&quot;:&quot;enum&quot;,&quot;required&quot;:true},{&quot;name&quot;:&quot;due_at&quot;,&quot;type&quot;:&quot;datetime&quot;,&quot;required&quot;:true}]</opl-dyn:parameters>
        <opl-dyn:emits>[&quot;ev_work_order_created&quot;]</opl-dyn:emits>
        <opl-dyn:executor>{&quot;kind&quot;:&quot;manual&quot;}</opl-dyn:executor>
        <opl-dyn:requiredRole>客服专员</opl-dyn:requiredRole>
    </opl-dyn:ActionType>

    <opl-dyn:ActionType rdf:about="http://example.org/ontology/unnamed/action_act_accept_work_order">
        <opl-dyn:name>accept_work_order</opl-dyn:name>
        <opl-dyn:displayName>受理工单</opl-dyn:displayName>
        <opl-dyn:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <opl-dyn:preconditions>[&quot;status == &apos;待受理&apos;&quot;]</opl-dyn:preconditions>
        <opl-dyn:emits>[&quot;ev_work_order_accepted&quot;]</opl-dyn:emits>
        <opl-dyn:executor>{&quot;kind&quot;:&quot;manual&quot;}</opl-dyn:executor>
        <opl-dyn:requiredRole>客服专员</opl-dyn:requiredRole>
    </opl-dyn:ActionType>

    <opl-dyn:ActionType rdf:about="http://example.org/ontology/unnamed/action_act_transfer_work_order">
        <opl-dyn:name>transfer_work_order</opl-dyn:name>
        <opl-dyn:displayName>转派服务部门</opl-dyn:displayName>
        <opl-dyn:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <opl-dyn:parameters>[{&quot;name&quot;:&quot;service_department_id&quot;,&quot;type&quot;:&quot;string&quot;,&quot;required&quot;:true},{&quot;name&quot;:&quot;reason&quot;,&quot;type&quot;:&quot;string&quot;,&quot;required&quot;:true}]</opl-dyn:parameters>
        <opl-dyn:preconditions>[&quot;status == &apos;已受理&apos;&quot;]</opl-dyn:preconditions>
        <opl-dyn:emits>[&quot;ev_transfer_created&quot;]</opl-dyn:emits>
        <opl-dyn:executor>{&quot;kind&quot;:&quot;manual&quot;}</opl-dyn:executor>
        <opl-dyn:requiredRole>客服专员</opl-dyn:requiredRole>
    </opl-dyn:ActionType>

    <opl-dyn:ActionType rdf:about="http://example.org/ontology/unnamed/action_act_accept_transfer">
        <opl-dyn:name>accept_transfer</opl-dyn:name>
        <opl-dyn:displayName>接收转派</opl-dyn:displayName>
        <opl-dyn:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <opl-dyn:preconditions>[&quot;status == &apos;待接收&apos;&quot;]</opl-dyn:preconditions>
        <opl-dyn:emits>[&quot;ev_transfer_accepted&quot;]</opl-dyn:emits>
        <opl-dyn:executor>{&quot;kind&quot;:&quot;manual&quot;}</opl-dyn:executor>
        <opl-dyn:requiredRole>服务部门受理人</opl-dyn:requiredRole>
    </opl-dyn:ActionType>

    <opl-dyn:ActionType rdf:about="http://example.org/ontology/unnamed/action_act_reject_transfer">
        <opl-dyn:name>reject_transfer</opl-dyn:name>
        <opl-dyn:displayName>退回转派</opl-dyn:displayName>
        <opl-dyn:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <opl-dyn:parameters>[{&quot;name&quot;:&quot;reason&quot;,&quot;type&quot;:&quot;string&quot;,&quot;required&quot;:true}]</opl-dyn:parameters>
        <opl-dyn:preconditions>[&quot;status == &apos;待接收&apos; || status == &apos;已转派&apos;&quot;]</opl-dyn:preconditions>
        <opl-dyn:emits>[&quot;ev_transfer_rejected&quot;]</opl-dyn:emits>
        <opl-dyn:executor>{&quot;kind&quot;:&quot;manual&quot;}</opl-dyn:executor>
        <opl-dyn:requiredRole>服务部门受理人</opl-dyn:requiredRole>
    </opl-dyn:ActionType>

    <opl-dyn:ActionType rdf:about="http://example.org/ontology/unnamed/action_act_schedule_appointment">
        <opl-dyn:name>schedule_appointment</opl-dyn:name>
        <opl-dyn:displayName>预约上门</opl-dyn:displayName>
        <opl-dyn:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <opl-dyn:parameters>[{&quot;name&quot;:&quot;scheduled_at&quot;,&quot;type&quot;:&quot;datetime&quot;,&quot;required&quot;:true},{&quot;name&quot;:&quot;technician_id&quot;,&quot;type&quot;:&quot;string&quot;,&quot;required&quot;:true}]</opl-dyn:parameters>
        <opl-dyn:preconditions>[&quot;status IN (&apos;已受理&apos;, &apos;已转派&apos;, &apos;待预约&apos;)&quot;]</opl-dyn:preconditions>
        <opl-dyn:emits>[&quot;ev_appointment_created&quot;]</opl-dyn:emits>
        <opl-dyn:executor>{&quot;kind&quot;:&quot;manual&quot;}</opl-dyn:executor>
        <opl-dyn:requiredRole>客服专员</opl-dyn:requiredRole>
    </opl-dyn:ActionType>

    <opl-dyn:ActionType rdf:about="http://example.org/ontology/unnamed/action_act_confirm_appointment">
        <opl-dyn:name>confirm_appointment</opl-dyn:name>
        <opl-dyn:displayName>确认预约</opl-dyn:displayName>
        <opl-dyn:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <opl-dyn:preconditions>[&quot;status == &apos;待预约&apos;&quot;]</opl-dyn:preconditions>
        <opl-dyn:emits>[&quot;ev_appointment_confirmed&quot;]</opl-dyn:emits>
        <opl-dyn:executor>{&quot;kind&quot;:&quot;manual&quot;}</opl-dyn:executor>
        <opl-dyn:requiredRole>客服专员</opl-dyn:requiredRole>
    </opl-dyn:ActionType>

    <opl-dyn:ActionType rdf:about="http://example.org/ontology/unnamed/action_act_reschedule_appointment">
        <opl-dyn:name>reschedule_appointment</opl-dyn:name>
        <opl-dyn:displayName>用户改约</opl-dyn:displayName>
        <opl-dyn:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <opl-dyn:parameters>[{&quot;name&quot;:&quot;scheduled_at&quot;,&quot;type&quot;:&quot;datetime&quot;,&quot;required&quot;:true}]</opl-dyn:parameters>
        <opl-dyn:preconditions>[&quot;status == &apos;待上门&apos;&quot;]</opl-dyn:preconditions>
        <opl-dyn:emits>[&quot;ev_appointment_rescheduled&quot;]</opl-dyn:emits>
        <opl-dyn:executor>{&quot;kind&quot;:&quot;manual&quot;}</opl-dyn:executor>
        <opl-dyn:requiredRole>客服专员</opl-dyn:requiredRole>
    </opl-dyn:ActionType>

    <opl-dyn:ActionType rdf:about="http://example.org/ontology/unnamed/action_act_start_visit">
        <opl-dyn:name>start_visit</opl-dyn:name>
        <opl-dyn:displayName>开始现场处理</opl-dyn:displayName>
        <opl-dyn:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <opl-dyn:preconditions>[&quot;status == &apos;待上门&apos;&quot;]</opl-dyn:preconditions>
        <opl-dyn:emits>[&quot;ev_visit_started&quot;]</opl-dyn:emits>
        <opl-dyn:executor>{&quot;kind&quot;:&quot;manual&quot;}</opl-dyn:executor>
        <opl-dyn:requiredRole>服务人员</opl-dyn:requiredRole>
    </opl-dyn:ActionType>

    <opl-dyn:ActionType rdf:about="http://example.org/ontology/unnamed/action_act_report_result">
        <opl-dyn:name>report_result</opl-dyn:name>
        <opl-dyn:displayName>反馈处理结果</opl-dyn:displayName>
        <opl-dyn:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <opl-dyn:parameters>[{&quot;name&quot;:&quot;result&quot;,&quot;type&quot;:&quot;string&quot;,&quot;required&quot;:true},{&quot;name&quot;:&quot;duration_minutes&quot;,&quot;type&quot;:&quot;integer&quot;,&quot;required&quot;:true}]</opl-dyn:parameters>
        <opl-dyn:preconditions>[&quot;status == &apos;处理中&apos;&quot;]</opl-dyn:preconditions>
        <opl-dyn:emits>[&quot;ev_result_reported&quot;]</opl-dyn:emits>
        <opl-dyn:executor>{&quot;kind&quot;:&quot;manual&quot;}</opl-dyn:executor>
        <opl-dyn:requiredRole>服务人员</opl-dyn:requiredRole>
    </opl-dyn:ActionType>

    <opl-dyn:ActionType rdf:about="http://example.org/ontology/unnamed/action_act_report_unresolved">
        <opl-dyn:name>report_unresolved</opl-dyn:name>
        <opl-dyn:displayName>登记一次未解决</opl-dyn:displayName>
        <opl-dyn:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <opl-dyn:parameters>[{&quot;name&quot;:&quot;result&quot;,&quot;type&quot;:&quot;string&quot;,&quot;required&quot;:true}]</opl-dyn:parameters>
        <opl-dyn:preconditions>[&quot;status == &apos;处理中&apos;&quot;]</opl-dyn:preconditions>
        <opl-dyn:emits>[&quot;ev_visit_unresolved&quot;]</opl-dyn:emits>
        <opl-dyn:executor>{&quot;kind&quot;:&quot;manual&quot;}</opl-dyn:executor>
        <opl-dyn:requiredRole>服务人员</opl-dyn:requiredRole>
    </opl-dyn:ActionType>

    <opl-dyn:ActionType rdf:about="http://example.org/ontology/unnamed/action_act_customer_accept">
        <opl-dyn:name>customer_accept</opl-dyn:name>
        <opl-dyn:displayName>用户验收通过</opl-dyn:displayName>
        <opl-dyn:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <opl-dyn:preconditions>[&quot;status == &apos;待验收&apos;&quot;]</opl-dyn:preconditions>
        <opl-dyn:emits>[&quot;ev_customer_accepted&quot;]</opl-dyn:emits>
        <opl-dyn:executor>{&quot;kind&quot;:&quot;manual&quot;}</opl-dyn:executor>
        <opl-dyn:requiredRole>用户</opl-dyn:requiredRole>
    </opl-dyn:ActionType>

    <opl-dyn:ActionType rdf:about="http://example.org/ontology/unnamed/action_act_customer_reject">
        <opl-dyn:name>customer_reject</opl-dyn:name>
        <opl-dyn:displayName>用户验收退回</opl-dyn:displayName>
        <opl-dyn:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <opl-dyn:parameters>[{&quot;name&quot;:&quot;reason&quot;,&quot;type&quot;:&quot;string&quot;,&quot;required&quot;:true}]</opl-dyn:parameters>
        <opl-dyn:preconditions>[&quot;status == &apos;待验收&apos;&quot;]</opl-dyn:preconditions>
        <opl-dyn:emits>[&quot;ev_customer_rejected&quot;]</opl-dyn:emits>
        <opl-dyn:executor>{&quot;kind&quot;:&quot;manual&quot;}</opl-dyn:executor>
        <opl-dyn:requiredRole>用户</opl-dyn:requiredRole>
    </opl-dyn:ActionType>

    <opl-dyn:ActionType rdf:about="http://example.org/ontology/unnamed/action_act_submit_feedback">
        <opl-dyn:name>submit_feedback</opl-dyn:name>
        <opl-dyn:displayName>提交回访评价</opl-dyn:displayName>
        <opl-dyn:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <opl-dyn:parameters>[{&quot;name&quot;:&quot;score&quot;,&quot;type&quot;:&quot;integer&quot;,&quot;required&quot;:true},{&quot;name&quot;:&quot;comment&quot;,&quot;type&quot;:&quot;string&quot;,&quot;required&quot;:false}]</opl-dyn:parameters>
        <opl-dyn:preconditions>[&quot;status == &apos;已完成&apos;&quot;]</opl-dyn:preconditions>
        <opl-dyn:emits>[&quot;ev_feedback_received&quot;]</opl-dyn:emits>
        <opl-dyn:executor>{&quot;kind&quot;:&quot;manual&quot;}</opl-dyn:executor>
        <opl-dyn:requiredRole>用户</opl-dyn:requiredRole>
    </opl-dyn:ActionType>

    <opl-dyn:ActionType rdf:about="http://example.org/ontology/unnamed/action_act_follow_up_result">
        <opl-dyn:name>follow_up_result</opl-dyn:name>
        <opl-dyn:displayName>催办结果反馈</opl-dyn:displayName>
        <opl-dyn:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <opl-dyn:parameters>[{&quot;name&quot;:&quot;message&quot;,&quot;type&quot;:&quot;string&quot;,&quot;required&quot;:true}]</opl-dyn:parameters>
        <opl-dyn:emits>[&quot;ev_follow_up_requested&quot;]</opl-dyn:emits>
        <opl-dyn:executor>{&quot;kind&quot;:&quot;manual&quot;}</opl-dyn:executor>
        <opl-dyn:requiredRole>客服专员</opl-dyn:requiredRole>
    </opl-dyn:ActionType>

    <opl-dyn:ActionType rdf:about="http://example.org/ontology/unnamed/action_act_escalate_transfer">
        <opl-dyn:name>escalate_transfer</opl-dyn:name>
        <opl-dyn:displayName>升级无人接收</opl-dyn:displayName>
        <opl-dyn:owner rdf:resource="http://example.org/ontology/unnamed/New-entity-4"/>
        <opl-dyn:parameters>[{&quot;name&quot;:&quot;reason&quot;,&quot;type&quot;:&quot;string&quot;,&quot;required&quot;:true}]</opl-dyn:parameters>
        <opl-dyn:emits>[&quot;ev_transfer_escalated&quot;]</opl-dyn:emits>
        <opl-dyn:executor>{&quot;kind&quot;:&quot;manual&quot;}</opl-dyn:executor>
        <opl-dyn:requiredRole>客服主管</opl-dyn:requiredRole>
    </opl-dyn:ActionType>

    <!-- ====== -->
    <!-- Rules (规则层) -->
    <!-- ====== -->

    <opl-dyn:Rule rdf:about="http://example.org/ontology/unnamed/rule_rule_transfer_timeout">
        <opl-dyn:name>transfer_response_timeout</opl-dyn:name>
        <opl-dyn:displayName>转派30分钟无人接收升级</opl-dyn:displayName>
        <opl-dyn:triggerOn>ev_transfer_created</opl-dyn:triggerOn>
        <opl-dyn:absent>{&quot;event&quot;:&quot;ev_transfer_accepted&quot;,&quot;within&quot;:&quot;30m&quot;,&quot;escalate&quot;:&quot;act_escalate_transfer&quot;}</opl-dyn:absent>
        <opl-dyn:propose>[{&quot;action&quot;:&quot;act_accept_transfer&quot;}]</opl-dyn:propose>
        <opl-dyn:severity>warning</opl-dyn:severity>
        <opl-dyn:status>active</opl-dyn:status>
    </opl-dyn:Rule>

    <opl-dyn:Rule rdf:about="http://example.org/ontology/unnamed/rule_rule_result_timeout">
        <opl-dyn:name>result_feedback_timeout</opl-dyn:name>
        <opl-dyn:displayName>接收后24小时未反馈催办</opl-dyn:displayName>
        <opl-dyn:triggerOn>ev_transfer_accepted</opl-dyn:triggerOn>
        <opl-dyn:absent>{&quot;event&quot;:&quot;ev_result_reported&quot;,&quot;within&quot;:&quot;24h&quot;,&quot;escalate&quot;:&quot;act_follow_up_result&quot;}</opl-dyn:absent>
        <opl-dyn:propose>[{&quot;action&quot;:&quot;act_schedule_appointment&quot;,&quot;argumentMapping&quot;:{&quot;scheduled_at&quot;:&quot;$event.payload.scheduled_at&quot;,&quot;technician_id&quot;:&quot;$event.payload.technician_id&quot;}}]</opl-dyn:propose>
        <opl-dyn:severity>critical</opl-dyn:severity>
        <opl-dyn:status>active</opl-dyn:status>
    </opl-dyn:Rule>

    <opl-dyn:Rule rdf:about="http://example.org/ontology/unnamed/rule_rule_revisit">
        <opl-dyn:name>revisit_after_unresolved</opl-dyn:name>
        <opl-dyn:displayName>一次未解决则再次预约</opl-dyn:displayName>
        <opl-dyn:triggerOn>ev_visit_unresolved</opl-dyn:triggerOn>
        <opl-dyn:propose>[{&quot;action&quot;:&quot;act_schedule_appointment&quot;}]</opl-dyn:propose>
        <opl-dyn:severity>info</opl-dyn:severity>
        <opl-dyn:status>active</opl-dyn:status>
    </opl-dyn:Rule>

    <!-- ================== -->
    <!-- Scenario Scripts (剧本层) -->
    <!-- ================== -->

    <opl-dyn:ScenarioScript rdf:about="http://example.org/ontology/unnamed/scenario_sc_full_service_flow">
        <opl-dyn:name>上门转派服务闭环</opl-dyn:name>
        <rdfs:comment>建单、转派、预约、现场处理、验收和回访评价完整闭环</rdfs:comment>
        <opl-dyn:given>[{&quot;seed&quot;:&quot;new-entity-3&quot;,&quot;object&quot;:&quot;R1&quot;,&quot;values&quot;:{&quot;id&quot;:&quot;R1&quot;,&quot;customer_id&quot;:&quot;C1&quot;,&quot;address_id&quot;:&quot;A1&quot;,&quot;category&quot;:&quot;设备故障&quot;,&quot;description&quot;:&quot;需要上门检查&quot;,&quot;urgency&quot;:&quot;高&quot;}}]</opl-dyn:given>
        <opl-dyn:when>[{&quot;action&quot;:&quot;act_create_work_order&quot;,&quot;object&quot;:&quot;R1&quot;,&quot;at&quot;:&quot;2026-10-26T09:00:00Z&quot;,&quot;args&quot;:{&quot;priority&quot;:&quot;高&quot;,&quot;due_at&quot;:&quot;2026-10-27T09:00:00Z&quot;},&quot;as&quot;:&quot;WO1&quot;,&quot;confirm&quot;:true},{&quot;action&quot;:&quot;act_accept_work_order&quot;,&quot;object&quot;:&quot;WO1&quot;,&quot;at&quot;:&quot;2026-10-26T09:05:00Z&quot;,&quot;confirm&quot;:true},{&quot;action&quot;:&quot;act_transfer_work_order&quot;,&quot;object&quot;:&quot;WO1&quot;,&quot;at&quot;:&quot;2026-10-26T09:10:00Z&quot;,&quot;args&quot;:{&quot;service_department_id&quot;:&quot;D1&quot;,&quot;reason&quot;:&quot;需专业部门上门&quot;},&quot;confirm&quot;:true},{&quot;action&quot;:&quot;act_accept_transfer&quot;,&quot;object&quot;:&quot;WO1&quot;,&quot;at&quot;:&quot;2026-10-26T09:20:00Z&quot;,&quot;confirm&quot;:true},{&quot;action&quot;:&quot;act_schedule_appointment&quot;,&quot;object&quot;:&quot;WO1&quot;,&quot;at&quot;:&quot;2026-10-26T09:25:00Z&quot;,&quot;args&quot;:{&quot;scheduled_at&quot;:&quot;2026-10-26T13:00:00Z&quot;,&quot;technician_id&quot;:&quot;T1&quot;},&quot;confirm&quot;:true},{&quot;action&quot;:&quot;act_confirm_appointment&quot;,&quot;object&quot;:&quot;WO1&quot;,&quot;at&quot;:&quot;2026-10-26T09:30:00Z&quot;,&quot;confirm&quot;:true},{&quot;action&quot;:&quot;act_start_visit&quot;,&quot;object&quot;:&quot;WO1&quot;,&quot;at&quot;:&quot;2026-10-26T13:00:00Z&quot;,&quot;confirm&quot;:true},{&quot;action&quot;:&quot;act_report_result&quot;,&quot;object&quot;:&quot;WO1&quot;,&quot;at&quot;:&quot;2026-10-26T14:00:00Z&quot;,&quot;args&quot;:{&quot;result&quot;:&quot;现场处理完成&quot;,&quot;duration_minutes&quot;:60},&quot;confirm&quot;:true},{&quot;action&quot;:&quot;act_customer_accept&quot;,&quot;object&quot;:&quot;WO1&quot;,&quot;at&quot;:&quot;2026-10-26T14:30:00Z&quot;,&quot;confirm&quot;:true},{&quot;action&quot;:&quot;act_submit_feedback&quot;,&quot;object&quot;:&quot;WO1&quot;,&quot;at&quot;:&quot;2026-10-26T15:00:00Z&quot;,&quot;args&quot;:{&quot;score&quot;:5,&quot;comment&quot;:&quot;处理及时&quot;},&quot;confirm&quot;:true}]</opl-dyn:when>
        <opl-dyn:then>[{&quot;kind&quot;:&quot;state&quot;,&quot;object&quot;:&quot;WO1&quot;,&quot;property&quot;:&quot;status&quot;,&quot;expect&quot;:&quot;已关闭&quot;},{&quot;kind&quot;:&quot;event-count&quot;,&quot;event&quot;:&quot;ev_result_reported&quot;,&quot;expect&quot;:1},{&quot;kind&quot;:&quot;event-count&quot;,&quot;event&quot;:&quot;ev_feedback_received&quot;,&quot;expect&quot;:1}]</opl-dyn:then>
    </opl-dyn:ScenarioScript>

    <opl-dyn:ScenarioScript rdf:about="http://example.org/ontology/unnamed/scenario_sc_service_exceptions">
        <opl-dyn:name>无人接收改约与再次上门</opl-dyn:name>
        <rdfs:comment>覆盖无人接收、用户改约和一次未解决后的再次预约</rdfs:comment>
        <opl-dyn:given>[{&quot;seed&quot;:&quot;new-entity-3&quot;,&quot;object&quot;:&quot;R2&quot;,&quot;values&quot;:{&quot;id&quot;:&quot;R2&quot;,&quot;customer_id&quot;:&quot;C2&quot;,&quot;address_id&quot;:&quot;A2&quot;,&quot;category&quot;:&quot;设备故障&quot;,&quot;description&quot;:&quot;需要专业部门处理&quot;,&quot;urgency&quot;:&quot;紧急&quot;}}]</opl-dyn:given>
        <opl-dyn:when>[{&quot;action&quot;:&quot;act_create_work_order&quot;,&quot;object&quot;:&quot;R2&quot;,&quot;at&quot;:&quot;2026-10-26T09:00:00Z&quot;,&quot;args&quot;:{&quot;priority&quot;:&quot;紧急&quot;,&quot;due_at&quot;:&quot;2026-10-26T18:00:00Z&quot;},&quot;as&quot;:&quot;WO2&quot;,&quot;confirm&quot;:true},{&quot;action&quot;:&quot;act_accept_work_order&quot;,&quot;object&quot;:&quot;WO2&quot;,&quot;at&quot;:&quot;2026-10-26T09:05:00Z&quot;,&quot;confirm&quot;:true},{&quot;action&quot;:&quot;act_transfer_work_order&quot;,&quot;object&quot;:&quot;WO2&quot;,&quot;at&quot;:&quot;2026-10-26T09:10:00Z&quot;,&quot;args&quot;:{&quot;service_department_id&quot;:&quot;D2&quot;,&quot;reason&quot;:&quot;客服无法处理&quot;},&quot;confirm&quot;:true},{&quot;action&quot;:&quot;act_escalate_transfer&quot;,&quot;object&quot;:&quot;WO2&quot;,&quot;at&quot;:&quot;2026-10-26T09:41:00Z&quot;,&quot;args&quot;:{&quot;reason&quot;:&quot;30分钟无人接收&quot;},&quot;confirm&quot;:true},{&quot;action&quot;:&quot;act_accept_transfer&quot;,&quot;object&quot;:&quot;WO2&quot;,&quot;at&quot;:&quot;2026-10-26T09:45:00Z&quot;,&quot;confirm&quot;:true},{&quot;action&quot;:&quot;act_schedule_appointment&quot;,&quot;object&quot;:&quot;WO2&quot;,&quot;at&quot;:&quot;2026-10-26T09:50:00Z&quot;,&quot;args&quot;:{&quot;scheduled_at&quot;:&quot;2026-10-26T13:00:00Z&quot;,&quot;technician_id&quot;:&quot;T2&quot;},&quot;confirm&quot;:true},{&quot;action&quot;:&quot;act_confirm_appointment&quot;,&quot;object&quot;:&quot;WO2&quot;,&quot;at&quot;:&quot;2026-10-26T09:55:00Z&quot;,&quot;confirm&quot;:true},{&quot;action&quot;:&quot;act_reschedule_appointment&quot;,&quot;object&quot;:&quot;WO2&quot;,&quot;at&quot;:&quot;2026-10-26T10:00:00Z&quot;,&quot;args&quot;:{&quot;scheduled_at&quot;:&quot;2026-10-26T15:00:00Z&quot;},&quot;confirm&quot;:true},{&quot;action&quot;:&quot;act_confirm_appointment&quot;,&quot;object&quot;:&quot;WO2&quot;,&quot;at&quot;:&quot;2026-10-26T10:05:00Z&quot;,&quot;confirm&quot;:true},{&quot;action&quot;:&quot;act_start_visit&quot;,&quot;object&quot;:&quot;WO2&quot;,&quot;at&quot;:&quot;2026-10-26T15:00:00Z&quot;,&quot;confirm&quot;:true},{&quot;action&quot;:&quot;act_report_unresolved&quot;,&quot;object&quot;:&quot;WO2&quot;,&quot;at&quot;:&quot;2026-10-26T16:00:00Z&quot;,&quot;args&quot;:{&quot;result&quot;:&quot;需补充配件后再次上门&quot;},&quot;confirm&quot;:true}]</opl-dyn:when>
        <opl-dyn:then>[{&quot;kind&quot;:&quot;state&quot;,&quot;object&quot;:&quot;WO2&quot;,&quot;property&quot;:&quot;status&quot;,&quot;expect&quot;:&quot;待预约&quot;},{&quot;kind&quot;:&quot;event-count&quot;,&quot;event&quot;:&quot;ev_transfer_escalated&quot;,&quot;expect&quot;:1},{&quot;kind&quot;:&quot;event-count&quot;,&quot;event&quot;:&quot;ev_visit_unresolved&quot;,&quot;expect&quot;:1}]</opl-dyn:then>
    </opl-dyn:ScenarioScript>

</rdf:RDF>
