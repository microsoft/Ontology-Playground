  <rdf:Description rdf:nodeID="nb9a7cbf03e084154beb56edd67bba306b3770">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLRule"/>
    <sh:construct>
        CONSTRUCT {
            $this brick:hasSubstance ?substance .
        } WHERE {
            $this rdf:type ?meter .
            ?meter rdfs:subClassOf* brick:Meter .
            ?meter brick:hasSubstance ?substance .
        }
        </sh:construct>
    <sh:prefixes rdf:resource="https://brickschema.org/schema/1.4/Brick"/>
  </rdf:Description>
