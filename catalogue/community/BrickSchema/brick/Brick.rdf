  <rdf:Description rdf:nodeID="nb9a7cbf03e084154beb56edd67bba306b3856">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLRule"/>
    <sh:construct>
CONSTRUCT {
    ?val a ?shape .
} WHERE {
    $this rdfs:range ?shape .
    ?shape a sh:NodeShape .
    ?ent $this ?val .
    FILTER NOT EXISTS { ?val a ?shape }
}</sh:construct>
    <sh:prefixes rdf:resource="https://brickschema.org/schema/1.4/Brick"/>
  </rdf:Description>
