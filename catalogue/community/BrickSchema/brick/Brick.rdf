    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLRule"/>
    <sh:construct>
CONSTRUCT {
    ?s ?t2 ?o .
} WHERE {
    ?s $this ?o .
    { $this owl:equivalentProperty ?t2 }
    UNION
    { ?t2 owl:equivalentProperty $this }
}</sh:construct>
