  <rdf:Description rdf:nodeID="nb9a7cbf03e084154beb56edd67bba306b2326">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#TripleRule"/>
    <sh:object rdf:resource="https://brickschema.org/schema/BrickTag#Equipment"/>
    <sh:predicate rdf:resource="https://brickschema.org/schema/Brick#hasTag"/>
