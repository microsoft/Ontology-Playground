  <rdf:Description rdf:nodeID="nb9a7cbf03e084154beb56edd67bba306b3922">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
    <sh:message>Only meters can have the isVirtualMeter property be true</sh:message>
    <sh:prefixes rdf:resource="https://brickschema.org/schema/1.4/Brick"/>
    <sh:select>
            SELECT $this WHERE {
                $this brick:isVirtualMeter/brick:value true .
                FILTER NOT EXISTS { $this rdf:type/rdfs:subClassOf* brick:Meter } .
            }
        </sh:select>
  </rdf:Description>
