  <rdf:Description rdf:nodeID="nb9a7cbf03e084154beb56edd67bba306b3768">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLRule"/>
    <sh:construct>
        CONSTRUCT {
            $this rdf:type ?metertype .
        } WHERE {
            $this rdf:type/rdfs:subClassOf* brick:Building_Meter .
            $this brick:hasSubstance ?substance .
            ?metertype brick:hasSubstance ?substance .
            ?metertype rdfs:subClassOf+ brick:Building_Meter .
        }
        </sh:construct>
    <sh:prefixes rdf:resource="https://brickschema.org/schema/1.4/Brick"/>
  </rdf:Description>
