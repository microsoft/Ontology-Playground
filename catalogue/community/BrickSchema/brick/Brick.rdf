  <rdf:Description rdf:about="https://brickschema.org/schema/Brick#Wet_Bulb_Temperature">
    <rdf:type rdf:resource="https://brickschema.org/schema/Brick#Quantity"/>
    <rdfs:label xml:lang="en">Wet Bulb Temperature</rdfs:label>
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG_C"/>
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG_F"/>
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/K"/>
    <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"/>
    <rdfs:isDefinedBy rdf:resource="https://brickschema.org/schema/Brick"/>
    <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Temperature"/>
    <skos:definition>The temperature read by a thermometer covered in water-soaked cloth (wet-bulb thermometer) over which air is passed. A wet-bulb thermometer indicates a temperature close to the true (thermodynamic) wet-bulb temperature. The wet-bulb temperature is the lowest temperature that can be reached under current ambient conditions by the evaporation of water only.  DBT is the temperature that is usually thought of as air temperature, and it is the true thermodynamic temperature. It indicates the amount of heat in the air and is directly proportional to the mean kinetic energy of the air molecule. (https://en.wikipedia.org/wiki/Wet-bulb_temperature)</skos:definition>
    <skos:definition xml:lang="en">The temperature read by a thermometer covered in water-soaked cloth (wet-bulb thermometer) over which air is passed. A wet-bulb thermometer indicates a temperature close to the true (thermodynamic) wet-bulb temperature. The wet-bulb temperature is the lowest temperature that can be reached under current ambient conditions by the evaporation of water only.  DBT is the temperature that is usually thought of as air temperature, and it is the true thermodynamic temperature. It indicates the amount of heat in the air and is directly proportional to the mean kinetic energy of the air molecule. (https://en.wikipedia.org/wiki/Wet-bulb_temperature)</skos:definition>
  </rdf:Description>
