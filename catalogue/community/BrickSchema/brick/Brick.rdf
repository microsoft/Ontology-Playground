    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLRule"/>
    <sh:construct>
            CONSTRUCT {
$this ?invP ?o .
}
WHERE {
?o ?p $this .
?invP owl:inverseOf ?p .
}
			</sh:construct>
