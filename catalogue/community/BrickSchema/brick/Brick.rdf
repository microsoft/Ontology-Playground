  <rdf:Description rdf:nodeID="nb9a7cbf03e084154beb56edd67bba306b3857">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLRule"/>
    <sh:construct>
            CONSTRUCT {
                ?s ?super ?skolemized .
                ?skolemized ?ep ?eo .
            } WHERE {
                $this rdfs:subPropertyOf+ ?super .
                ?super a brick:EntityProperty .
                $this a brick:EntityProperty .
                ?s $this ?o .
                BIND(IF(isBlank(?o), IRI(CONCAT("urn:skolem:", STRUUID())), ?o) AS ?skolemized)
                ?o ?ep ?eo .
            }
        </sh:construct>
    <sh:prefixes rdf:resource="https://brickschema.org/schema/1.4/Brick"/>
  </rdf:Description>
