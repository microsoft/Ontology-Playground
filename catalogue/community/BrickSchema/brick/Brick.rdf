    <sh:construct>
        CONSTRUCT {
            $this brick:hasQuantity ?quantity .
        } WHERE {
            $this rdfs:subClassOf+ ?parent .
            ?parent brick:hasQuantity ?quantity .
            FILTER NOT EXISTS {
                $this brick:hasQuantity ?quantity .
            }
        }
        </sh:construct>
    <sh:prefixes rdf:resource="https://brickschema.org/schema/1.4/Brick"/>
