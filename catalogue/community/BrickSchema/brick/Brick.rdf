  <rdf:Description rdf:nodeID="nb9a7cbf03e084154beb56edd67bba306b3541">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLRule"/>
    <sh:construct>
        CONSTRUCT {
            $this rec:includes ?eq .
        }
        WHERE {
            $this brick:hasPart ?eq .
            {
                ?eq rdf:type/rdfs:subClassOf* brick:Equipment .
            }
            UNION
            {
                ?eq rdf:type/rdfs:subClassOf* brick:Collection .
            }
            UNION
            {
                ?eq rdf:type/rdfs:subClassOf* brick:System .
            }
        }
        </sh:construct>
    <sh:prefixes rdf:resource="https://brickschema.org/schema/1.4/Brick"/>
  </rdf:Description>
